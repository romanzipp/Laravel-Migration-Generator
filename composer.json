{
    "name": "romanzipp/laravel-migration-generator",
    "description": "Laravel Migration Generator",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "romanzipp",
            "email": "ich@ich.wtf",
            "homepage": "https://ich.wtf"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "doctrine/dbal": "^4.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "romanzipp/php-cs-fixer-config": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "romanzipp\\MigrationGenerator\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "romanzipp\\MigrationGenerator\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "romanzipp\\MigrationGenerator\\Providers\\MigrationGeneratorProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
